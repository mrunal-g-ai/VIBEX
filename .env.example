# ==============================================================================
# VIBEX Environment Configuration Template
# ==============================================================================

# 1. Gemini AI API Key (Required for backend AI mentor & curriculum generation)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Node/Express Backend Port (Default: 5000)
PORT=5000

# 3. Client-side Centralized API Base URL (Required for Mobile / Installed App Builds)
# - For local web development: Leave empty (defaults to relative '/api' proxy)
# - For physical Android / iOS device testing on local Wi-Fi: e.g. "http://192.168.1.50:5000"
# - For production cloud backend: e.g. "https://api.vibex.app"
VITE_API_BASE_URL=""

# 4. Optional Application URL (for self-referential links / OAuth)
APP_URL="http://localhost:5000"
