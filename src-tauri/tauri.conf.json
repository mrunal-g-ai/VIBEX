{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VIBEX",
  "version": "1.0.0",
  "identifier": "com.vibex.music",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VIBEX – AI Music Learning Platform",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "AI Music Learning Platform for Keyboard, Guitar, Violin, and Bansuri",
    "longDescription": "VIBEX is an interactive music education application featuring real-time audio pitch and rhythm detection, computer vision posture feedback, and intelligent AI music mentoring.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
